--- lib/utils/notify.c
+++ lib/utils/notify.c
@@ -48,5 +48,29 @@
 sys_notify_generic_callback sys_notify_finalize(struct sys_notify *notify,
 						    int res)
 {
-    /* MASKED - implement this function */
+	sys_notify_generic_callback cb = NULL;
+	uint32_t method = sys_notify_get_method(notify);
+
+	/* Store result before marking completion so fetch_result
+	 * never sees COMPLETED with a stale result.
+	 */
+	notify->result = res;
+	notify->flags = 0;
+
+	switch (method) {
+	case SYS_NOTIFY_METHOD_SPINWAIT:
+		break;
+#ifdef CONFIG_POLL
+	case SYS_NOTIFY_METHOD_SIGNAL:
+		k_poll_signal_raise(notify->method.signal, res);
+		break;
+#endif /* CONFIG_POLL */
+	case SYS_NOTIFY_METHOD_CALLBACK:
+		cb = notify->method.callback;
+		break;
+	default:
+		break;
+	}
+
+	return cb;
 }




