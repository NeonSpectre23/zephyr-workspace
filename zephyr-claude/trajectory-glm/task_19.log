+/* CRC-24 implementation from the section 6.1 of the RFC 4880 */
+uint32_t __weak crc24_pgp_update(uint32_t crc, const uint8_t *data, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		crc = ((crc << 8) & 0xFFFFFF) ^ crc24q[data[i] ^ (crc >> 16)];
+	}
+
+	return crc;
+}
