--- lib/utils/winstream.c
+++ lib/utils/winstream.c
@@ -85,5 +85,41 @@
 uint32_t sys_winstream_read(struct sys_winstream *ws,
 			    uint32_t *seq, char *buf, uint32_t buflen)
 {
-    /* MASKED - implement this function */
+	uint32_t start, end, seq1, avail;
+	uint32_t start_seq, read_pos, read_len, suffix;
+
+	seq1 = ws->seq;
+	READ_BARRIER();
+	end = ws->end;
+	start = ws->start;
+
+	if (seq1 == 0) {
+		*seq = 0;
+		return 0;
+	}
+
+	avail = idx_sub(ws, end, start);
+	start_seq = seq1 - avail;
+
+	if (*seq < start_seq) {
+		/* Data overwritten since last read, sync forward */
+		*seq = seq1;
+		return 0;
+	}
+
+	if (*seq >= seq1) {
+		return 0;
+	}
+
+	read_pos = idx_mod(ws, start + (*seq - start_seq));
+	read_len = min(seq1 - *seq, buflen);
+
+	suffix = min(read_len, ws->len - read_pos);
+	MEMCPY(buf, &ws->data[read_pos], suffix);
+	if (read_len > suffix) {
+		MEMCPY(buf + suffix, &ws->data[0], read_len - suffix);
+	}
+
+	*seq += read_len;
+	return read_len;
 }




