=== Diff ===
============================================================
--- subsys/fs/fcb/fcb.c
+++ subsys/fs/fcb/fcb.c
@@ -229,7 +229,22 @@
 
 int fcb_get_len(const struct fcb *fcbp, uint8_t *buf, uint16_t *len)
 {
-    /* MASKED - implement this function */
+	uint8_t decode;
+
+	decode = buf[0] ^ ~fcbp->f_erase_value;
+	if (!(decode & 0x80)) {
+		*len = decode;
+		return 1;
+	}
+
+	decode &= 0x7f;
+	*len = decode | ((buf[1] ^ ~fcbp->f_erase_value) << 7);
+
+	if (*len > FCB_MAX_LEN) {
+		return -EINVAL;
+	}
+
+	return 2;
 }
 
