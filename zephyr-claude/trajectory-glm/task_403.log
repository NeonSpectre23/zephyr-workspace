--- lib/utils/winstream.c
+++ lib/utils/winstream.c
@@ -40,7 +40,49 @@
 void sys_winstream_write(struct sys_winstream *ws,
 			 const char *data, uint32_t len)
 {
-    /* MASKED - implement this function */
+	uint32_t lenmsg = len, lenmsg0 = len;
+
+	if (ws->len == 0) {
+		return;
+	}
+
+	/* If the message is much larger than the buffer, truncate
+	 * and mark the buffer as empty (start = end).
+	 */
+	if (lenmsg > ws->len + 1) {
+		ws->start = ws->end;
+		lenmsg = ws->len - 1;
+	}
+	lenmsg = min(lenmsg, ws->len);
+
+	/* Advance start to make room if needed */
+	if (ws->seq != 0) {
+		uint32_t avail = (ws->len - 1) - idx_sub(ws, ws->end, ws->start);
+
+		if (lenmsg > avail) {
+			ws->start = idx_mod(ws, ws->start + (lenmsg - avail));
+		}
+	}
+
+	/* If we truncated input, drop old buffer content and skip
+	 * the dropped prefix bytes from the input data.
+	 */
+	if (lenmsg < lenmsg0) {
+		ws->start = ws->end;
+		data += lenmsg0 - lenmsg;
+	}
+
+	/* Copy data into the circular buffer, handling wraparound */
+	uint32_t suffix = min(lenmsg, ws->len - ws->end);
+
+	MEMCPY(&ws->data[ws->end], data, suffix);
+	if (lenmsg > suffix) {
+		MEMCPY(&ws->data[0], data + suffix, lenmsg - suffix);
+	}
+
+	WRITE_BARRIER();
+	ws->end = idx_mod(ws, ws->end + lenmsg);
+	ws->seq += lenmsg0;
 }
 
