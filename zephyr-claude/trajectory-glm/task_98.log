--- lib/os/p4wq.c
+++ lib/os/p4wq.c
@@ -226,7 +226,35 @@
 
 void k_p4wq_submit(struct k_p4wq *queue, struct k_p4wq_work *item)
 {
-    /* MASKED - implement this function */
+	k_spinlock_key_t key = k_spin_lock(&queue->lock);
+
+	if (item->thread == _current) {
+		sys_dlist_remove(&item->dlnode);
+		thread_set_requeued(_current);
+	}
+
+	item->thread = NULL;
+	rb_insert(&queue->queue, &item->rbnode);
+
+	struct k_p4wq_work *lowest = NULL;
+	struct k_p4wq_work *w;
+
+	SYS_DLIST_FOR_EACH_CONTAINER(&queue->active, w, dlnode) {
+		if (lowest == NULL || item_lessthan(w, lowest)) {
+			lowest = w;
+		}
+	}
+
+	if (lowest == NULL || item_lessthan(item, lowest)) {
+		struct k_thread *th = z_unpend_first_thread(&queue->waitq);
+
+		if (th) {
+			set_prio(th, item);
+			z_ready_thread(th);
+		}
+	}
+
+	z_reschedule(&queue->lock, key);
 }
 
 bool k_p4wq_cancel(struct k_p4wq *queue, struct k_p4wq_work *item)




