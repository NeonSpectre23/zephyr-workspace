The implementation is complete. Here's how `net_timeout_evaluate` works:

1. **Completion check**: If elapsed time >= total remaining, the timeout has expired — return 0 without modifying state.
2. **Early return with wraps pending**: If elapsed < `NET_TIMEOUT_MAX_VALUE` and there are wrap counts remaining, no state update is needed — just return how long until the next re-evaluation is required (`MAX - elapsed`).
3. **Consume elapsed time**: Subtract elapsed from total, re-normalize into `wrap_counter` + `timer_timeout` (maintaining the invariant that `timer_timeout` is zero only when complete), re-anchor `timer_start` to `now`, and return the next delay — `NET_TIMEOUT_MAX_VALUE` if wraps remain, otherwise the fractional timeout.


============================================================
=== Diff ===
============================================================
--- subsys/net/ip/net_timeout.c
+++ subsys/net/ip/net_timeout.c
@@ -78,5 +78,30 @@
 uint32_t net_timeout_evaluate(struct net_timeout *timeout,
 			      uint32_t now)
 {
-    /* MASKED - implement this function */
+	uint32_t elapsed = now - timeout->timer_start;
+	uint64_t total = (uint64_t)timeout->timer_timeout
+		+ (uint64_t)NET_TIMEOUT_MAX_VALUE * timeout->wrap_counter;
+
+	if (elapsed >= total) {
+		return 0;
+	}
+
+	if (elapsed < NET_TIMEOUT_MAX_VALUE && timeout->wrap_counter > 0U) {
+		return NET_TIMEOUT_MAX_VALUE - elapsed;
+	}
+
+	uint64_t remaining = total - (uint64_t)elapsed;
+	uint32_t wraps = remaining / NET_TIMEOUT_MAX_VALUE;
+	uint32_t frac = remaining % NET_TIMEOUT_MAX_VALUE;
+
+	if (frac == 0U) {
+		frac = NET_TIMEOUT_MAX_VALUE;
+		wraps -= 1U;
+	}
+
+	timeout->timer_start = now;
+	timeout->wrap_counter = wraps;
+	timeout->timer_timeout = frac;
+
+	return (wraps > 0U) ? NET_TIMEOUT_MAX_VALUE : frac;
 }




