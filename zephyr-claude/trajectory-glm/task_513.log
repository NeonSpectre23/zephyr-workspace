--- include/zephyr/math/interpolation.h
+++ include/zephyr/math/interpolation.h
@@ -42,9 +42,40 @@
  * @retval int32_t Linear interpolation between the two nearest @a y_axis values.
  */
 static inline int32_t linear_interpolate(const int32_t *x_axis, const int32_t *y_axis, uint8_t len,
-					 int32_t x)
+						 int32_t x)
 {
-    /* MASKED - implement this function */
+	if (x <= x_axis[0]) {
+		return y_axis[0];
+	}
+	if (x >= x_axis[len - 1]) {
+		return y_axis[len - 1];
+	}
+
+	uint8_t i;
+	for (i = 0; i < len - 1; i++) {
+		if (x < x_axis[i + 1]) {
+			break;
+		}
+	}
+
+	int64_t dy = (int64_t)y_axis[i + 1] - y_axis[i];
+	int64_t dx_num = (int64_t)x - x_axis[i];
+	int64_t dx_den = (int64_t)x_axis[i + 1] - x_axis[i];
+
+	/* Compute full numerator: y0 * dx_den + dy * dx_num
+	 * This allows correct round-half-away-from-zero on the final result
+	 * rather than only on the fractional increment.
+	 */
+	int64_t numer = (int64_t)y_axis[i] * dx_den + dy * dx_num;
+
+	/* Round half away from zero */
+	if (numer >= 0) {
+		numer += dx_den / 2;
+	} else {
+		numer -= dx_den / 2;
+	}
+
+	return (int32_t)(numer / dx_den);
 }
 
