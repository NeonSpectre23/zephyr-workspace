=== Diff ===
============================================================
--- subsys/crc/crc4_sw.c
+++ subsys/crc/crc4_sw.c
@@ -9,7 +9,32 @@
 uint8_t __weak crc4(const uint8_t *src, size_t len, uint8_t polynomial, uint8_t initial_value,
 	     bool reversed)
 {
-    /* MASKED - implement this function */
+	uint8_t crc = initial_value;
+	size_t i, j, k;
+
+	for (i = 0; i < len; i++) {
+		for (j = 0; j < 2; j++) {
+			crc ^= ((src[i] >> (4 * (1 - j))) & 0xf);
+
+			for (k = 0; k < 4; k++) {
+				if (reversed) {
+					if (crc & 0x01) {
+						crc = (crc >> 1) ^ polynomial;
+					} else {
+						crc >>= 1;
+					}
+				} else {
+					if (crc & 0x8) {
+						crc = (crc << 1) ^ polynomial;
+					} else {
+						crc <<= 1;
+					}
+				}
+			}
+		}
+	}
+
+	return crc & 0xF;
 }
 
 uint8_t __weak crc4_ti(uint8_t seed, const uint8_t *src, size_t len)




