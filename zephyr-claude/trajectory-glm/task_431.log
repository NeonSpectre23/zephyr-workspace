=== Claude Session ===
============================================================
The implementation follows the same pattern as `usbd_unregister_all_classes`:

1. **HS path**: iterates `usbd_class_hs` section, skips blocklisted classes, registers each with `usbd_register_class`
2. **FS path**: iterates `usbd_class_fs` section, same logic
3. **Unsupported speed**: returns `-ENOTSUP`

This mirrors the unregister counterpart exactly — same section iteration, same error handling, same return values — just calling `usbd_register_class` instead of `usbd_unregister_class` and using `is_blocklisted` to skip entries from the blocklist.


============================================================
=== Diff ===
============================================================
--- subsys/usb/device_next/usbd_class.c
+++ subsys/usb/device_next/usbd_class.c
@@ -357,7 +357,45 @@
 			      const enum usbd_speed speed, const uint8_t cfg,
 			      const char *const blocklist[])
 {
-    /* MASKED - implement this function */
+	int ret;
+
+	if (USBD_SUPPORTS_HIGH_SPEED && speed == USBD_SPEED_HS) {
+		STRUCT_SECTION_FOREACH_ALTERNATE(usbd_class_hs, usbd_class_node, c_nd) {
+			if (is_blocklisted(c_nd, blocklist)) {
+				continue;
+			}
+
+			ret = usbd_register_class(uds_ctx, c_nd->c_data->name,
+						  speed, cfg);
+			if (ret) {
+				LOG_ERR("Failed to register %s to HS configuration %u",
+					c_nd->c_data->name, cfg);
+				return ret;
+			}
+		}
+
+		return 0;
+	}
+
+	if (speed == USBD_SPEED_FS) {
+		STRUCT_SECTION_FOREACH_ALTERNATE(usbd_class_fs, usbd_class_node, c_nd) {
+			if (is_blocklisted(c_nd, blocklist)) {
+				continue;
+			}
+
+			ret = usbd_register_class(uds_ctx, c_nd->c_data->name,
+						  speed, cfg);
+			if (ret) {
+				LOG_ERR("Failed to register %s to FS configuration %u",
+					c_nd->c_data->name, cfg);
+				return ret;
+			}
+		}
+
+		return 0;
+	}
+
+	return -ENOTSUP;
 }
 
 int usbd_unregister_class(struct usbd_context *const uds_ctx,




