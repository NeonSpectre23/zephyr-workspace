+		int64_t local_delta = (int64_t)(local - tsp->base.local);
+		int64_t ref_delta = (local_delta * cfg->ref_Hz) / cfg->local_Hz;
+#ifdef CONFIG_TIMEUTIL_APPLY_SKEW
