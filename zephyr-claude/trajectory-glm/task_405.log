 float timeutil_sync_estimate_skew(const struct timeutil_sync_state *tsp)
 {
-    /* MASKED - implement this function */
+	if ((tsp->base.ref == 0) || (tsp->latest.ref == 0)
+	    || (tsp->latest.local <= tsp->base.local)) {
+		return 0.0f;
+	}
+
+	const struct timeutil_sync_config *cfg = tsp->cfg;
+	int64_t ref_delta = (int64_t)(tsp->latest.ref - tsp->base.ref);
+	int64_t local_delta = (int64_t)(tsp->latest.local - tsp->base.local);
+
+	return (float)((double)ref_delta * cfg->local_Hz)
+	       / (float)((double)local_delta * cfg->ref_Hz);
 }
 
