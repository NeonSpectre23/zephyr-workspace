+		/* Mark packet as claimed (busy). */
+		((union mpsc_pbuf_generic *)item)->hdr.busy = 1;
+		buffer->tmp_rd_idx = idx_inc(buffer, buffer->tmp_rd_idx, wlen);
+
+		k_spin_unlock(&buffer->lock, key);
+		MPSC_PBUF_DBG(buffer, "claimed %p", item);
